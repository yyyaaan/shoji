#!/bin/sh
# Forwards one Claude Code or Codex hook payload to Shoji: thread id line, then the JSON from stdin.
# Always exits 0, fast and silent.
if [ -z "$SHOJI_THREAD_ID" ] || [ ! -S "$SHOJI_SOCKET" ]; then
  cat >/dev/null
  exit 0
fi
{
  printf '%s\n' "$SHOJI_THREAD_ID"
  cat
} | /usr/bin/nc -U -w 1 "$SHOJI_SOCKET" >/dev/null 2>&1
exit 0
